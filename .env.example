# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL="file:./data/ts6webui.db"
# REQUIRED in every environment — the backend refuses to start without these.
# There is deliberately no default: a fallback secret ships a known signing key.
# Generate each one separately with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
# Encrypts stored ServerQuery keys, SSH passwords, Discord tokens and TOTP
# secrets. MUST differ from JWT_SECRET, so leaking one does not expose the other.
# Changing it later makes existing encrypted rows unreadable — set it once.
ENCRYPTION_KEY=change-this-to-a-different-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Origin the browser actually uses to reach the UI. This is the CORS allow-list
# value, so it must match exactly — scheme, host and port. Behind a domain or a
# reverse proxy, put that URL here, not localhost.
FRONTEND_URL=http://localhost:5173
# Host port the frontend container publishes (Docker only). Change it here
# rather than editing docker-compose.yml, which git tracks.
FRONTEND_PORT=3000

# Media sidecar — shared secret for the sidecar HTTP API. Required only when the
# sidecar runs as its own container (SIDECAR_URL set); when the backend spawns it
# locally a random token is generated per process and this can stay unset.
SIDECAR_TOKEN=change-this-to-a-random-string

# Frontend (Vite env vars)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws


# --- Video streaming / IPTV ---
# Hardware encoding, the encoder profile, the default preset, stream
# visibility and the IPTV playlist are configured in the web UI under
# Settings -> Streaming, not here. The sidecar still needs the GPU device
# passed through to the container — see docker-compose.yml.
# GID owning /dev/dri/renderD128 on the host, so the unprivileged sidecar
# user may open it. Find it with: stat -c '%g' /dev/dri/renderD128
RENDER_GID=104

# --- Local test environment ---
# TeamSpeak server image for docker-compose.test.yml /
# docker-compose.tsserver.yml. No default: it depends which server build you
# have. See docs/local-testing.md.
TS_SERVER_IMAGE=
# Host ports for the test stack. Defaults are shifted off the production
# numbers (TeamSpeak +1, manager +10) so the rig can run beside a real
# deployment. Override only if a default is already taken.
TEST_TS_VOICE_PORT=9988
TEST_TS_WEBQUERY_PORT=10081
TEST_TS_SSH_PORT=10023
TEST_TS_FILE_PORT=30034
TEST_FRONTEND_PORT=3010
TEST_BACKEND_PORT=3011
TEST_FRONTEND_URL=http://localhost:3010
