# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL="file:./data/ts6webui.db"
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
# Required in production, must differ from JWT_SECRET (encrypts stored credentials)
ENCRYPTION_KEY=change-this-to-a-different-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
FRONTEND_URL=http://localhost:5173

# Media sidecar — shared secret between backend and sidecar HTTP API
SIDECAR_TOKEN=change-this-to-a-random-string

# Frontend (Vite env vars)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws
