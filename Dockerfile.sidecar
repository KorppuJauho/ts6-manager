# syntax=docker/dockerfile:1.4
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY packages/sidecar/go.mod packages/sidecar/go.sum ./
RUN go mod download
# Every .go file, and build the package rather than a named file: naming
# main.go explicitly compiles that file alone, so a second source file is
# silently left out and only fails once something references it.
COPY packages/sidecar/*.go ./
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /sidecar .

FROM debian:bookworm-slim
# One VA-API driver per GPU vendor: intel-media-va-driver (iHD) for Intel,
# mesa-va-drivers (radeonsi) for AMD. libva picks the one matching the render
# node's kernel driver, so both can be present. NVIDIA needs neither: FFmpeg's
# h264_nvenc loads the driver's own libraries, which the NVIDIA Container
# Toolkit mounts in at run time (docker-compose.nvidia.yml).
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg ca-certificates \
      intel-media-va-driver mesa-va-drivers libva-drm2 && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    useradd --system --no-create-home --shell /usr/sbin/nologin sidecar
COPY --from=build /sidecar /usr/local/bin/sidecar
USER sidecar
# Inside a container the API must bind the bridge interface; never publish
# this port — the backend reaches it over the internal network.
ENV SIDECAR_LISTEN_ADDR=0.0.0.0
EXPOSE 9800
CMD ["sidecar"]
