generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String?
  displayName  String
  role         String    @default("viewer")
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  mustChangePassword Boolean @default(false) // force a password change at next login

  serverAccess  UserServerAccess[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  family     String?
  replacedBy String?
}

model UserServerAccess {
  id             Int            @id @default(autoincrement())
  userId         Int
  serverConfigId Int
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)

  @@unique([userId, serverConfigId])
}

/// A TeamSpeak server the bots connect to. The voice port is per bot.
model TsServerConfig {
  id        Int      @id @default(autoincrement())
  name      String
  host      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAccess    UserServerAccess[]
  musicBots     MusicBot[]
  songs         Song[]
  playlists     Playlist[]
  radioStations RadioStation[]
  musicRequests MusicRequest[]
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// === Music / Voice Bot Models ===

model MusicBot {
  id              Int            @id @default(autoincrement())
  name            String
  serverConfigId  Int
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  nickname        String         @default("MusicBot")
  serverPassword  String?
  defaultChannel  String?
  channelPassword String?
  voicePort       Int            @default(9987)
  volume          Int            @default(50)
  identityData    String?
  autoStart       Boolean        @default(false)
  streamPreset    String         @default("1080p")
  sidecarPort     Int            @default(9800)
  /// "upload", "default" (the bundled app icon) or "none". Bots that existed
  /// before avatars get "none" from db push; new bots are created with
  /// "default".
  avatarMode      String         @default("none")
  /// The original upload in data/bot-avatars/, as the web UI shows it. What
  /// TeamSpeak gets (shrunk to fit 300×300 when larger) sits beside it.
  avatarFile      String?
  /// MD5 of the file TeamSpeak gets: the bot's client_flag_avatar.
  avatarMd5       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  playlists Playlist[]
}

model Song {
  id             Int            @id @default(autoincrement())
  title          String
  artist         String?
  duration       Float?
  filePath       String
  source         String         @default("local")
  sourceUrl      String?
  fileSize       Int?
  serverConfigId Int
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  playlistSongs PlaylistSong[]
}

model Playlist {
  id             Int             @id @default(autoincrement())
  name           String
  musicBotId     Int?
  musicBot       MusicBot?       @relation(fields: [musicBotId], references: [id], onDelete: SetNull)
  /// Scope. Song is already scoped per server config, so without this two
  /// TeamSpeak servers importing the same YouTube playlist would contend for
  /// one row and mix tracks from different libraries.
  serverConfigId Int?
  serverConfig   TsServerConfig? @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  /// YouTube playlist id, set on import. Null for hand-made playlists.
  sourceId       String?
  createdAt      DateTime        @default(now())

  songs PlaylistSong[]

  @@unique([serverConfigId, sourceId])
}

model PlaylistSong {
  id         Int      @id @default(autoincrement())
  playlistId Int
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  songId     Int
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  position   Int      @default(0)

  @@unique([playlistId, songId])
}

model RadioStation {
  id             Int            @id @default(autoincrement())
  name           String
  url            String
  genre          String?
  imageUrl       String?
  serverConfigId Int
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
}

model MusicRequest {
  id             Int            @id @default(autoincrement())
  title          String
  url            String
  serverConfigId Int
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  requestedAt    DateTime       @default(now())

  @@unique([serverConfigId, url])
}

model SpotifySettings {
  id             Int      @id @default(autoincrement())
  enabled        Boolean  @default(false)
  clientId       String?
  clientSecret   String?
  maxAlbumTracks Int      @default(50)
  updatedAt      DateTime @updatedAt
}

model MusicCommandSettings {
  id               Int      @id @default(autoincrement())
  notifyNowPlaying Boolean  @default(false) // post "now playing" in the bot's TS channel
  updatedAt        DateTime @updatedAt
}

/// Video streaming configuration. A single row: these are host-level
/// settings (which GPU, which encoder, which playlist), not per-server ones.
model StreamSettings {
  id Int @id @default(autoincrement())

  // Hardware encoding. encoderProfile is a key from the sidecar's registry;
  // the sidecar falls back to software if the host cannot run it.
  hwAccelEnabled Boolean @default(false)
  hwAccelDevice  String  @default("/dev/dri/renderD128")
  encoderProfile String  @default("vp8_software")

  // Preset a stream uses when the caller does not name one.
  defaultPreset String @default("720p")

  // The largest preset "auto" may choose; a named preset ignores it.
  autoMaxPreset String @default("2160p")

  // IPTV (!tv). channelFilter is comma-separated substrings; empty offers
  // every channel in the playlist.
  iptvEnabled       Boolean @default(false)
  iptvPlaylistUrl   String?
  iptvChannelFilter String?
  iptvSort          String  @default("name") // name | playlist

  updatedAt DateTime @updatedAt
}
