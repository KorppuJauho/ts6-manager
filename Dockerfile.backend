# syntax=docker/dockerfile:1.4
# Node 20 reached end-of-life in April 2026 — track the active LTS line.
FROM node:22-slim AS base
# The npm bundled with the Node image lags behind and prints upgrade notices
# on every npx invocation at container start.
RUN npm install -g npm@11 && corepack enable && corepack prepare pnpm@9 --activate
# node-gyp builds native deps (@discordjs/opus, cpu-features, ssh2) during
# pnpm install and needs a toolchain and python3 present in the base stage.
RUN apt-get update && apt-get install -y --no-install-recommends python3 build-essential && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install system deps: openssl (Prisma), ffmpeg (audio), python3 (yt-dlp)
# yt-dlp lives in its own venv instead of polluting the system Python
# (avoids --break-system-packages).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      openssl \
      ffmpeg \
      python3 \
      python3-venv \
      ca-certificates \
    && python3 -m venv /opt/yt-dlp \
    && /opt/yt-dlp/bin/pip install --no-cache-dir -U "yt-dlp[default]" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/yt-dlp/bin:$PATH"

WORKDIR /app

FROM base AS build
# Toolchain for native modules (@discordjs/opus compiles from source);
# build stage only — the production stage copies the compiled node_modules.
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Dependency layer: copy ONLY the workspace manifests + lockfile, then install.
# This layer — which includes the slow native compilation of @discordjs/opus —
# is cached by BuildKit and only re-runs when a package.json or the lockfile
# changes, NOT on every source edit. (Previously a single `COPY . .` before the
# install invalidated this on any file change, recompiling opus every build.)
# Trailing-slash destinations are the BuildKit-safe form for copying a single
# file into a nested path; node_modules is excluded via .dockerignore so the
# later `COPY . .` never clobbers the installed (Linux-compiled) modules.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/common/package.json   ./packages/common/
COPY packages/backend/package.json  ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/
RUN pnpm install --no-frozen-lockfile

# Source layer: bring in the rest and build. A code-only change invalidates
# from here down and reuses the cached dependency layer above.
COPY . .
RUN pnpm --filter @ts6/common run build
RUN pnpm --filter @ts6/backend exec prisma generate
RUN pnpm --filter @ts6/backend run build

# Production image
FROM base AS production
ENV NODE_ENV=production
WORKDIR /app

# Application code is owned by `node`, the user that runs it. COPY preserves
# the modes a file had in the build context, and a clone made under a
# restrictive umask (0077) arrives here mode 0600 root-owned — unreadable to
# `node`, which fails at container start with
# `EACCES: permission denied, open '/app/packages/backend/package.json'`.
# Owning the files makes those modes grant access instead of denying it, so a
# checkout's umask stops being part of the deployment contract. `chmod -R a+rX`
# on the host is the same fix applied to the wrong side of the build.
#
# node_modules stays root-owned and world-readable on purpose: it is installed
# in-container (excluded from the context by .dockerignore), so it never
# carries host modes, and leaving it unwritable by the app denies the easiest
# place to persist code after a compromise.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build --chown=node:node /app/packages/common/dist ./packages/common/dist
COPY --from=build --chown=node:node /app/packages/common/package.json ./packages/common/package.json
COPY --from=build --chown=node:node /app/packages/backend/dist ./packages/backend/dist
COPY --from=build --chown=node:node /app/packages/backend/generated ./packages/backend/generated
COPY --from=build --chown=node:node /app/packages/backend/prisma ./packages/backend/prisma
COPY --from=build --chown=node:node /app/packages/backend/prisma.config.ts ./packages/backend/prisma.config.ts
COPY --from=build --chown=node:node /app/packages/backend/package.json ./packages/backend/package.json
COPY --from=build /app/packages/backend/node_modules ./packages/backend/node_modules

WORKDIR /app/packages/backend
# Run as the unprivileged 'node' user shipped with the base image.
# Only chown the paths node writes to at runtime (SQLite data, music, yt-dlp
# config + venv); the code it merely reads is chowned by COPY above.
# `RUN chown -R` over all of /app (tens of thousands of node_modules files)
# was the slow build step and is what this avoids.
RUN mkdir -p data /data/music /home/node/.config/yt-dlp && \
    echo "--js-runtimes node" > /home/node/.config/yt-dlp/config && \
    chown -R node:node data /data/music /home/node/.config /opt/yt-dlp
USER node
ENV HOME=/home/node

EXPOSE 3001
ENV SIDECAR_URL=http://ts6-sidecar:9800
# The Prisma 7 major upgrade is a deliberate migration, not a container-start
# decision — silence the CLI update banner until then.
ENV PRISMA_HIDE_UPDATE_MESSAGE=1
# Refresh yt-dlp on every start (best effort): YouTube breaks stale versions
# within weeks, and the image is only rebuilt occasionally.
CMD ["sh", "-c", "(pip install --no-cache-dir -qU 'yt-dlp[default]' || true) && npx prisma db push --skip-generate && npx prisma db seed || true && node dist/index.js"]
